<header class="bar"><div class="w">
  <span class="bar-l"><%= area_line.map { |x| e x }.join(' · ') %></span>
  <nav aria-label="Main"><a href="#services">Services</a><a href="#about">About</a><a href="#visit">Visit</a></nav>
</div></header>
<main id="top">
<section class="poster"><div class="w">
  <h1 aria-label="<%= e name %>"><span class="narrow" aria-hidden="true"><%= poster_html(name, 6.8, '') %></span><span class="wide" aria-hidden="true"><%= poster_html(name, 8.6, '') %></span></h1>
  <div class="pfoot">
    <p class="lede"><%= e lede %></p>
    <div class="pmeta">
      <%= rating_line %>
      <%= today_line %>
    </div>
    <div class="acts"><%= action_btns %></div>
  </div>
</div></section>

<div class="strip">
  <%= ph(0, 900, sizes: '(min-width:860px) 34vw, 70vw', lazy: false) %>
  <%= ph(1, 900, sizes: '(min-width:860px) 34vw, 70vw') %>
  <%= ph(2, 900, sizes: '(min-width:860px) 34vw, 70vw') %>
</div>
<p class="note w"><%= e photo_note %></p>

<section id="services" class="sec"><div class="w">
  <h2><%= svc_title %></h2>
  <ol class="rows">
<% services.each_with_index do |(title, desc, _), i| -%>
    <li><span class="no"><%= '%02d' % (i + 1) %></span><h3><%= e title %></h3><p><%= e desc %></p></li>
<% end -%>
  </ol>
  <%= menu.empty? ? svc_note : '' %>
<% unless menu.empty? -%>
  <div class="prices" id="prices"><h2>Prices</h2><%= menu_html %></div>
<% end -%>
  <%= areas_html %>
</div></section>

<section id="about" class="sec about"><div class="w">
  <h2><%= e s['about_h'] %></h2>
  <div class="ab">
    <p><%= e s['about'] %></p>
    <%= about_link %>
  </div>
  <div class="ab-ph"><%= ph(3, 1000, sizes: '(min-width:860px) 40vw, 100vw') %><%= yours %></div>
</div></section>

<section id="visit" class="visit"><div class="w">
  <h2>Visit</h2>
<% if addr? -%>
  <a class="where" href="<%= maps %>" target="_blank" rel="noopener"><%= e street %><% unless blank?(city) %><span><%= e city %></span><% end %></a>
<% end -%>
  <div class="v-g">
    <div><%= contact_dl %><div class="acts"><%= action_btns(max: 2) %></div></div>
    <div><%= hours_html %></div>
    <%= map_html %>
  </div>
</div></section>
</main>
