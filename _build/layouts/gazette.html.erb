<header class="mast"><div class="w">
  <p class="mast-top"><span><%= tx trade %></span><i aria-hidden="true"> &middot; </i><span class="r"><%= tx [area, extra].reject { |x| blank?(x) }.join(' · ') %></span></p>
  <h1 class="plate"><%= name_h %></h1>
  <nav aria-label="Main"><a href="#services"><%= food? ? 'Menu' : 'Services' %></a><a href="#about">Story</a><a href="#visit">Visit</a><span class="nav-now"><%= now %></span></nav>
</div></header>
<main id="top">
<% if ph?(0) -%>
<div class="cover"><%= ph(0, 1800, sizes: '100vw', lazy: false) %></div>
<% end -%>
<section class="lead<%= ph?(0) ? '' : ' no-cover' %>"><div class="w">
  <div class="lead-h">
    <p class="hl"><%= tx lede %></p>
    <p class="deck"><%= tx sub_line %></p>
    <div class="acts"><%= action_btns %></div>
  </div>
  <aside class="glance" aria-label="At a glance">
    <h2>At a glance</h2>
    <dl>
<% if rating? || proof -%>
      <div><dt><%= (rating? || proof =~ /review/i) ? 'Reviews' : 'Note' %></dt><dd><%= rating_line %></dd></div>
<% end -%>
<% if addr? -%>
      <div><dt>Where</dt><dd><%= addr_html %></dd></div>
<% end -%>
<% unless blank?(s['hours']) -%>
      <div><dt>Hours</dt><dd><%= week ? now + %( <a class="tl sm" href="#visit">All hours</a>) : (hours_note? ? hours_note_html : e(s['hours'])) %></dd></div>
<% end -%>
<% if tel? -%>
      <div><dt>Phone</dt><dd><a class="plain" href="tel:<%= e s['tel'] %>"><%= tx s['phone'] %></a></dd></div>
<% end -%>
    </dl>
  </aside>
</div></section>

<section id="services" class="sec svc"><div class="w">
  <h2 class="rule-h"><span><%= svc_title %></span></h2>
  <ul class="cols">
<% services.each do |title, desc, _| -%>
    <li><h3><%= tx title %></h3><p><%= tx desc %></p></li>
<% end -%>
  </ul>
  <%= menu.empty? ? svc_note : '' %>
<% unless menu.empty? -%>
  <div class="prices" id="prices"><h2 class="rule-h"><span>Prices</span></h2><%= menu_html %></div>
<% end -%>
  <%= areas_html %>
</div></section>

<section id="about" class="story<%= ph?(1) ? '' : ' solo' %>"><div class="w">
  <div class="story-g">
    <div class="story-t">
      <h2><%= tx about_h %></h2>
      <p class="drop"><%= tx s['about'] %></p>
      <%= about_link %>
    </div>
    <%= ph(1, 1200, cls: 'story-img', sizes: '(min-width:860px) 42vw, 100vw') %>
  </div>
</div></section>
<% plates = [ph(2, 1200, cls: 'p-a', sizes: '(min-width:860px) 58vw, 100vw'), ph(3, 800, cls: 'p-b', sizes: '(min-width:860px) 36vw, 50vw'), yours('p-c')].reject(&:empty?) -%>
<% unless plates.empty? -%>

<section class="sec plates"><div class="w">
  <div class="pl-g k<%= plates.size %>">
    <%= plates.join("\n    ") %>
  </div>
</div></section>
<% end -%>

<section id="visit" class="sec visit"><div class="w">
  <h2 class="visit-h">Visit<% if addr? && street =~ /\d/ %> <span><%= tx street %></span><% end %></h2>
  <div class="v-g">
    <div class="v-a"><%= contact_dl %><div class="acts"><%= action_btns(max: 2) %></div></div>
<% if hours_table? -%>
    <div class="v-b"><%= hours_html %></div>
<% end -%>
    <%= map_html %>
  </div>
</div></section>
</main>
