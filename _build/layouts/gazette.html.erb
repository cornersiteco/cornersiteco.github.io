<header class="mast"><div class="w">
  <div class="mast-top"><span><%= e trade %></span><span class="r"><%= e area %></span></div>
  <h1 class="plate"><%= e name %></h1>
  <nav aria-label="Main"><a href="#services"><%= food? ? 'Menu' : 'Services' %></a><a href="#about">Story</a><a href="#visit">Visit</a><span class="nav-now"><%= now %></span></nav>
</div></header>
<main id="top">
<div class="cover"><%= ph(0, 1800, sizes: '100vw', lazy: false) %></div>
<section class="lead"><div class="w">
  <div class="lead-h">
    <p class="hl"><%= e lede %></p>
    <p class="deck"><%= e s['sub'] %></p>
    <div class="acts"><%= action_btns %></div>
  </div>
  <aside class="glance" aria-label="At a glance">
    <h2>At a glance</h2>
    <dl>
<% if rating? || proof -%>
      <div><dt><%= (rating? || proof =~ /review/i) ? 'Reviews' : 'Note' %></dt><dd><%= rating_line %></dd></div>
<% end -%>
<% if addr? -%>
      <div><dt>Where</dt><dd><%= addr_html %></dd></div>
<% end -%>
<% unless blank?(s['hours']) -%>
      <div><dt>Hours</dt><dd><%= week ? now + %( <a class="tl sm" href="#visit">All hours</a>) : e(s['hours']) %></dd></div>
<% end -%>
<% if tel? -%>
      <div><dt>Phone</dt><dd><a class="plain" href="tel:<%= e s['tel'] %>"><%= e s['phone'] %></a></dd></div>
<% end -%>
    </dl>
  </aside>
</div></section>

<section id="services" class="sec svc"><div class="w">
  <h2 class="rule-h"><span><%= svc_title %></span></h2>
  <ol class="cols">
<% services.each_with_index do |(title, desc, _), i| -%>
    <li><span class="no">No. <%= i + 1 %></span><h3><%= e title %></h3><p><%= e desc %></p></li>
<% end -%>
  </ol>
  <%= menu.empty? ? svc_note : '' %>
<% unless menu.empty? -%>
  <div class="prices" id="prices"><h2 class="rule-h"><span>Prices</span></h2><%= menu_html %></div>
<% end -%>
  <%= areas_html %>
</div></section>

<section id="about" class="sec story"><div class="w">
  <h2 class="rule-h"><span>Story</span></h2>
  <div class="story-g">
    <div class="story-t">
      <h3><%= e s['about_h'] %></h3>
      <p class="drop"><%= e s['about'] %></p>
      <%= about_link %>
    </div>
    <%= ph(1, 1200, cls: 'story-img', sizes: '(min-width:860px) 42vw, 100vw') %>
  </div>
</div></section>

<section class="sec plates"><div class="w">
  <div class="pl-g">
    <%= ph(2, 1200, cls: 'p-a', sizes: '(min-width:860px) 58vw, 100vw') %>
    <%= ph(3, 800, cls: 'p-b', sizes: '(min-width:860px) 36vw, 50vw') %>
    <%= yours('p-c') %><%= draft? ? '' : ph(0, 800, cls: 'p-c', sizes: '(min-width:860px) 36vw, 50vw') %>
  </div>
  <p class="note"><%= e photo_note %></p>
</div></section>

<section id="visit" class="sec visit"><div class="w">
  <h2 class="rule-h"><span>Visit</span></h2>
  <div class="v-g">
    <div class="v-a"><%= contact_dl %><div class="acts"><%= action_btns(max: 2) %></div></div>
    <div class="v-b"><%= hours_html %></div>
    <%= map_html %>
  </div>
</div></section>
</main>
