<header class="top"><div class="w">
  <span class="top-l"><%= now %></span>
  <nav aria-label="Main"><a href="#about">About</a><a href="#visit">Visit</a><%= primary_link('tl') %></nav>
</div></header>
<main id="top">
<section class="stage"><div class="w">
  <div class="board">
    <p class="est"><%= area_line.map { |x| e x }.join(' &middot; ') %></p>
    <h1 class="name"><%= e name %></h1>
    <p class="lede"><%= e lede %></p>
    <div class="orn" aria-hidden="true"></div>
    <div id="services">
      <h2 class="bh"><%= svc_title %></h2>
      <ul class="items">
<% services.each do |title, desc, _| -%>
        <li><h3><%= e title %></h3><p><%= e desc %></p></li>
<% end -%>
      </ul>
      <%= menu_html %>
      <%= menu.empty? ? svc_note : '' %>
    </div>
    <div class="bfoot">
      <%= rating_line %>
      <%= week ? '' : today_line %>
      <div class="acts"><%= action_btns %></div>
    </div>
  </div>
  <div class="side">
    <%= ph(0, 1000, cls: 's-a', sizes: '(min-width:860px) 40vw, 100vw', lazy: false) %>
    <%= ph(1, 800, cls: 's-b', sizes: '(min-width:860px) 40vw, 100vw') %>
  </div>
</div></section>

<section id="about" class="sec about"><div class="w">
  <div class="card">
    <h2><%= e s['about_h'] %></h2>
    <p><%= e s['about'] %></p>
    <%= about_link %>
  </div>
</div></section>

<section class="sec prints"><div class="w">
  <div class="pr">
    <%= ph(2, 800, sizes: '(min-width:860px) 30vw, 80vw') %>
    <%= ph(3, 800, sizes: '(min-width:860px) 30vw, 80vw') %>
    <%= yours %><%= draft? ? '' : ph(0, 800, sizes: '(min-width:860px) 30vw, 80vw') %>
  </div>
  <p class="note"><%= e photo_note %></p>
  <%= areas_html %>
</div></section>

<section id="visit" class="sec visit"><div class="w">
  <h2>Come by</h2>
  <div class="v-g">
    <div class="v-card"><%= contact_dl %></div>
    <div class="v-card"><h3>Hours</h3><%= hours_html %></div>
    <%= map_html %>
  </div>
</div></section>
</main>
