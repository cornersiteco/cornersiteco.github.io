<header class="gtop"><div class="w">
  <a class="brand" href="#top"><%= e name %></a>
  <nav aria-label="Main"><a href="#services">Services</a><a href="#about">About</a><a href="#visit">Visit</a></nav>
  <span class="r"><%= now %></span>
</div></header>
<main id="top">
<div class="wall<%= draft? ? ' has-yours' : '' %>" aria-label="Photos">
  <%= ph(0, 1400, cls: 'w0', sizes: '(min-width:860px) 50vw, 78vw', lazy: false, n: '1') %>
  <%= ph(1, 800, cls: 'w1', sizes: '(min-width:860px) 25vw, 78vw', n: '2') %>
  <%= ph(2, 800, cls: 'w2', sizes: '(min-width:860px) 25vw, 78vw', n: '3') %>
  <%= ph(3, 800, cls: 'w3', sizes: '(min-width:860px) 25vw, 78vw', n: '4') %>
  <%= yours('w4') %>
</div>
<section class="intro"><div class="w">
  <div class="in-a">
    <p class="trade"><%= area_line.map { |x| e x }.join(' · ') %></p>
    <h1 class="name"><%= e name %></h1>
  </div>
  <div class="in-b">
    <p class="lede"><%= e lede %></p>
    <%= rating_line %>
    <div class="acts"><%= action_btns %></div>
    <p class="note"><%= e photo_note %></p>
  </div>
</div></section>

<section id="services" class="sec"><div class="w">
  <h2><%= svc_title %></h2>
  <ul class="grid">
<% services.each_with_index do |(title, desc, _), i| -%>
    <li><span class="no"><%= i + 1 %>/<%= services.size %></span><h3><%= e title %></h3><p><%= e desc %></p></li>
<% end -%>
  </ul>
  <%= menu.empty? ? svc_note : '' %>
<% unless menu.empty? -%>
  <div class="prices" id="prices"><h2>Prices</h2><%= menu_html %></div>
<% end -%>
  <%= areas_html %>
</div></section>

<section id="about" class="sec about"><div class="w">
<% if rating? -%>
  <a class="score" href="<%= maps %>" target="_blank" rel="noopener"><span class="big"><%= e s['rating'] %></span><span><span class="stars" aria-hidden="true"><%= stars(s['rating']) %></span><br><%= e s['reviews'] %> Google reviews</span></a>
<% end -%>
  <div class="ab">
    <h2><%= e s['about_h'] %></h2>
    <p><%= e s['about'] %></p>
    <%= about_link %>
  </div>
</div></section>

<section id="visit" class="sec visit"><div class="w">
  <h2>Visit</h2>
  <div class="v-g">
    <div class="v-a"><%= contact_dl %><div class="acts"><%= action_btns(max: 2) %></div></div>
    <div class="v-b"><%= hours_html %></div>
    <%= map_html %>
  </div>
</div></section>
</main>
