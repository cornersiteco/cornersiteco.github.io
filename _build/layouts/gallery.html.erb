<header class="gtop"><div class="w">
  <a class="brand" href="#top"><%= e name %></a>
  <nav aria-label="Main"><a href="#services">Services</a><a href="#about">About</a><a href="#visit">Visit</a></nav>
  <span class="r"><%= now %></span>
</div></header>
<main id="top">
<% tiles = [ph(0, 1400, cls: 't0', sizes: '(min-width:860px) 50vw, 78vw', lazy: false), ph(1, 800, cls: 't1', sizes: '(min-width:860px) 25vw, 78vw'), ph(2, 800, cls: 't2', sizes: '(min-width:860px) 25vw, 78vw'), ph(3, 800, cls: 't3', sizes: '(min-width:860px) 25vw, 78vw'), yours('ty')].reject(&:empty?) -%>
<% wall = tiles.empty? ? '' : %(<div class="wall T#{tiles.size}" aria-label="Photos">\n  #{tiles.join("\n  ")}\n</div>) -%>
<%= draft? ? '' : wall %>
<section class="intro"><div class="w">
  <div class="in-a">
    <p class="trade"><%= area_line.map { |x| e x }.join(' · ') %></p>
    <h1 class="name"><%= name_h %></h1>
  </div>
  <div class="in-b">
    <p class="lede"><%= e lede %></p>
    <div class="in-m"><%= rating_line %><%= week ? now('in-now') : (hours_note? ? hours_note_html : '') %></div>
    <div class="acts"><%= action_btns %></div>
  </div>
</div></section>
<%= draft? ? wall : '' %>

<section id="services" class="sec"><div class="w">
  <h2><%= svc_title %></h2>
  <ul class="grid g<%= services.size %>">
<% services.each do |title, desc, _| -%>
    <li><h3><%= e title %></h3><p><%= e desc %></p></li>
<% end -%>
  </ul>
  <%= menu.empty? ? svc_note : '' %>
<% unless menu.empty? -%>
  <div class="prices" id="prices"><h2>Prices</h2><%= menu_html %></div>
<% end -%>
  <%= areas_html %>
</div></section>

<section id="about" class="sec about"><div class="w">
<% if rating? -%>
  <a class="score" href="<%= maps %>" target="_blank" rel="noopener"><span class="big"><%= e s['rating'] %></span><span><span class="stars" aria-hidden="true"><%= stars(s['rating']) %></span><br><%= e s['reviews'] %> Google reviews</span></a>
<% end -%>
  <div class="ab">
    <h2><%= e about_h %></h2>
    <p><%= e s['about'] %></p>
    <%= about_link %>
  </div>
</div></section>

<section id="visit" class="sec visit"><div class="w">
  <h2>Visit</h2>
  <div class="v-g">
    <div class="v-a"><%= contact_dl %><div class="acts"><%= action_btns(max: 2) %></div></div>
<% if hours_table? -%>
    <div class="v-b"><%= hours_html %></div>
<% end -%>
    <%= map_html %>
  </div>
</div></section>
</main>
