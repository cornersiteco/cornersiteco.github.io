<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% unless s['final'] %><meta name="robots" content="noindex, nofollow"><% end %><% if s['final'] && s['canonical'] %><link rel="canonical" href="<%= e s['canonical'] %>"><% end %>
<title><%= e s['name'] %><%= s['final'] ? ' — ' + e(s['kicker'].split(' · ').first) + ', ' + e(s['address'].split(',')[-2].to_s.strip) : (s['sample'] ? ' — sample site by Corner Site Co.' : ' — draft concept by Corner Site Co.') %></title>
<meta name="description" content="<%= e s['sub'] %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= e s['name'] %><%= (s['sample'] || s['final']) ? '' : ' — website draft' %>">
<meta property="og:description" content="<%= e s['sub'] %>">
<meta property="og:image" content="<%= img(s['photos'][0], 1200) %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="<%= t['bg'] %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://images.unsplash.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=<%= gfont(t['font_h'], t['font_h_w']) %>&family=Inter:wght@400;500;600;700&display=swap">
<link rel="preload" as="image" href="<%= img(s['photos'][0], 1800) %>">
<style>
:root{--bg:<%= t['bg'] %>;--surface:<%= t['surface'] %>;--ink:<%= t['ink'] %>;--muted:<%= t['muted'] %>;--accent:<%= t['accent'] %>;--accent-ink:<%= t['accent_ink'] %>;--line:<%= t['line'] %>;--r:<%= t['radius'] %>;--fh:"<%= t['font_h'] %>",Georgia,serif;--fb:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:72px;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--fb);font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased}
a{color:inherit}img{max-width:100%;display:block}
.w{max-width:1180px;margin:0 auto;padding:0 22px}
h1,h2,h3{font-family:var(--fh);font-weight:<%= t['font_h_w'] %>;line-height:1.04;margin:0;letter-spacing:<%= t['upper'] ? '-.01em' : '-.02em' %>;<%= t['upper'] ? 'text-transform:uppercase;' : '' %>text-wrap:balance}
h2{font-size:clamp(34px,5vw,58px)}
.kick{display:inline-flex;align-items:center;gap:10px;font-size:13px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.kick::before{content:"";width:22px;height:2px;background:currentColor}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border-radius:999px;font-weight:600;font-size:16px;text-decoration:none;transition:transform .2s,background .2s,box-shadow .2s;white-space:nowrap}
.btn:active{transform:scale(.98)}
.btn-p{background:var(--accent);color:var(--accent-ink);box-shadow:0 10px 30px -10px var(--accent)}
.btn-p:hover{filter:brightness(1.07)}
.btn-g{background:rgba(255,255,255,.12);color:#fff;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.28)}
.btn-g:hover{background:rgba(255,255,255,.2)}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:8px}

/* draft banner */
.draft{background:#111;color:#e5e5e5;font-size:13px;line-height:1.4;padding:9px 0;text-align:center}
.draft a{color:#fff;font-weight:600}
.draft b{color:#fff}

/* header */
header{position:absolute;left:0;right:0;z-index:20;color:#fff}
header .w{display:flex;align-items:center;justify-content:space-between;height:76px;gap:16px}
.brand{font-family:var(--fh);font-weight:<%= t['font_h_w'] %>;font-size:22px;letter-spacing:<%= t['upper'] ? '.02em' : '-.01em' %>;<%= t['upper'] ? 'text-transform:uppercase;' : '' %>text-decoration:none;max-width:60vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
nav{display:flex;align-items:center;gap:28px;font-size:15px;font-weight:500}
nav a{text-decoration:none;opacity:.88}nav a:hover{opacity:1}
nav .btn{min-height:42px;padding:0 18px;font-size:15px}

/* hero */
.hero{position:relative;min-height:min(92vh,860px);display:flex;align-items:flex-end;color:#fff;isolation:isolate;overflow:hidden}
.hero .bgimg{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;transform:scale(1.04)}
.hero::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.45) 45%,rgba(0,0,0,.1) 80%),linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,.1) 30%,rgba(0,0,0,.3) 60%,rgba(0,0,0,.85) 100%)}
.hero h1,.hero p.lead{text-shadow:0 2px 24px rgba(0,0,0,.35)}
.hero .w{padding-top:140px;padding-bottom:clamp(48px,8vw,96px);width:100%}
.hero .kick{color:#fff;opacity:.9}
.hero h1{font-size:clamp(44px,8vw,104px);max-width:14ch;margin:18px 0 20px}
.hero p.lead{font-size:clamp(18px,2vw,21px);max-width:44ch;margin:0 0 32px;color:rgba(255,255,255,.86)}
.ctas{display:flex;flex-wrap:wrap;gap:12px}
.proof{display:inline-flex;align-items:center;gap:12px;margin-top:34px;padding:10px 16px 10px 12px;border-radius:999px;background:rgba(255,255,255,.12);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.22);font-size:14px}
.proof .g{width:26px;height:26px;border-radius:50%;background:#fff;display:grid;place-items:center;flex:none}
.stars{color:#fbbf24;letter-spacing:1px;font-size:15px}.stars .off{opacity:.35}.stars .st{background:linear-gradient(90deg,#fbbf24 var(--f),rgba(150,150,150,.45) var(--f));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.gal .yours{display:grid;place-items:center;text-align:center;border:2px dashed currentColor;opacity:.75;padding:18px}.gal .yours b{display:block;font-size:18px;margin-bottom:6px}.gal .yours span{font-size:14px;line-height:1.4}
.offer .ol{margin:0 0 22px;font-size:18px;line-height:1.5;color:#1d1d1f}
.proof b{font-weight:700}

/* info bar */
.info{background:var(--surface);border-bottom:1px solid var(--line)}
.info .w{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}
.info a,.info div.it{display:flex;align-items:center;gap:14px;padding:24px 22px;text-decoration:none;border-right:1px solid var(--line)}
.info .it:last-child{border-right:0}
.info .ic{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 14%,transparent);color:var(--accent);flex:none}
.info small{display:block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.info strong{font-size:16px;font-weight:600}

/* sections */
.sec{padding:clamp(80px,11vw,140px) 0}
.head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:clamp(36px,5vw,56px)}
.head p{max-width:420px;color:var(--muted);margin:0}
.svc{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.card{background:var(--surface);border-radius:var(--r);padding:30px 28px 32px;box-shadow:0 0 0 1px var(--line);transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-4px);box-shadow:0 0 0 1px var(--line),0 24px 50px -30px rgba(0,0,0,.45)}
.card .ic{width:52px;height:52px;border-radius:14px;display:grid;place-items:center;background:var(--accent);color:var(--accent-ink);margin-bottom:26px}
.card h3{font-size:<%= t['upper'] ? '24px' : '26px' %>;margin-bottom:10px;line-height:1.1}
.card p{margin:0;color:var(--muted);font-size:16px}
.note{margin-top:18px;font-size:13px;color:var(--muted)}

/* split */
.split{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(32px,6vw,80px);align-items:center}
.split .ph{position:relative;border-radius:calc(var(--r) * 1.4);overflow:hidden;aspect-ratio:4/5}
.split .ph img{width:100%;height:100%;object-fit:cover}
.split .badge{position:absolute;left:18px;bottom:18px;right:18px;display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:16px;background:rgba(0,0,0,.55);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);color:#fff}
.split .badge .big{font-family:var(--fh);font-size:40px;line-height:1;font-weight:<%= t['font_h_w'] %>}
.split h2{margin:16px 0 20px}
.split p{color:var(--muted);font-size:19px;margin:0 0 28px;max-width:46ch}
.link{display:inline-flex;align-items:center;gap:8px;font-weight:600;color:var(--accent);text-decoration:none}
.link:hover{text-decoration:underline}

/* gallery */
.gal{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:16px;height:clamp(420px,55vw,620px)}
.gal figure{margin:0;border-radius:var(--r);overflow:hidden;position:relative}
.gal figure:first-child{grid-row:1/3}
.gal img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.gal figure:hover img{transform:scale(1.04)}
.gal-note{margin-top:14px;font-size:13px;color:var(--muted)}

/* visit */
.visit{display:grid;grid-template-columns:1fr 1.3fr;gap:18px;align-items:stretch}
.vcard{background:var(--surface);border-radius:var(--r);padding:clamp(28px,4vw,44px);box-shadow:0 0 0 1px var(--line);display:flex;flex-direction:column;gap:24px}
.vcard .row>div{min-width:0}.vcard a{overflow-wrap:anywhere}
.row{display:flex;gap:16px;align-items:flex-start}
.row .ic{color:var(--accent);flex:none;margin-top:2px}
.row small{display:block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:2px}
.row a{text-decoration:none;font-weight:600}
.map{border-radius:var(--r);overflow:hidden;min-height:380px;box-shadow:0 0 0 1px var(--line);background:var(--surface)}
.map iframe{width:100%;height:100%;min-height:380px;border:0;display:block<%= t['dark'] ? ';filter:grayscale(.2) invert(.9) hue-rotate(180deg)' : '' %>}

/* final cta */
.final{position:relative;color:#fff;isolation:isolate;overflow:hidden;text-align:center}
.final img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}
.final::before{content:"";position:absolute;inset:0;z-index:-1;background:rgba(0,0,0,.68)}
.final h2{max-width:16ch;margin:0 auto 18px}
.final p{color:rgba(255,255,255,.82);margin:0 auto 32px;max-width:44ch;font-size:19px}
.final .ctas{justify-content:center}

footer{padding:36px 0 120px;font-size:14px;color:var(--muted);border-top:1px solid var(--line)}
footer .w{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px}
footer a{color:var(--ink)}
.own{background:var(--accent);color:var(--accent-ink);text-align:center;padding:16px 22px;font-weight:600;font-size:15px}
.offer{background:#fafaf7;color:#1d1d1f;padding:clamp(56px,8vw,96px) 0;border-top:1px solid rgba(0,0,0,.08);font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
.offer .ow{max-width:760px;margin:0 auto;padding:0 22px}
.offer .oe{margin:0 0 14px;font:500 11px/1.4 ui-monospace,'SF Mono',Menlo,Consolas,monospace;letter-spacing:.18em;text-transform:uppercase;color:#6e6e73}
.offer h2{font-family:Georgia,'Times New Roman',serif;font-weight:400;text-transform:none;letter-spacing:-.01em;font-size:clamp(30px,4.6vw,46px);line-height:1.08;color:#1d1d1f;margin:0 0 26px}
.offer ol{list-style:none;margin:0 0 30px;padding:0;counter-reset:s}
.offer li{counter-increment:s;display:grid;grid-template-columns:34px 1fr;gap:12px;padding:16px 0;border-top:1px solid rgba(0,0,0,.08);font-size:16.5px;line-height:1.5;color:#424245}
.offer li::before{content:'0' counter(s);font:500 12px/1.9 ui-monospace,'SF Mono',Menlo,monospace;letter-spacing:.12em;color:#6e6e73}
.offer li b{color:#1d1d1f}
.offer .oc{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:26px}
.offer .ob{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 22px;border-radius:3px;font-weight:600;font-size:15.5px;text-decoration:none;color:#1d1d1f;box-shadow:inset 0 0 0 1px rgba(0,0,0,.2)}
.offer .ob.p{background:#1d1d1f;color:#fafaf7;box-shadow:none}
.offer .who{display:flex;align-items:center;gap:14px;margin:0;font-size:14.5px;line-height:1.5;color:#6e6e73}
.offer .who img{width:52px;height:52px;border-radius:50%;object-fit:cover;flex:none}
.offer .who a{color:#1d1d1f}
@media (max-width:560px){.offer .ob{flex:1 1 100%}}
.draft .dl{color:#fff;font-weight:600;margin-left:6px;white-space:nowrap}
.own a{color:inherit}

/* mobile bar */
.mbar{display:none}
.rv{opacity:0;transform:translateY(22px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}
.rv.in{opacity:1;transform:none}
@media (max-width:860px){
  nav a:not(.btn){display:none}
  .info .w{grid-template-columns:1fr}.info a,.info div.it{border-right:0;border-bottom:1px solid var(--line);padding:18px 22px}
  .split,.visit{grid-template-columns:1fr}
  .split .ph{aspect-ratio:4/3}
  .gal{grid-template-columns:1fr 1fr;grid-template-rows:auto auto;height:auto}
  .gal figure:first-child{grid-column:1/3;grid-row:auto;aspect-ratio:16/10}
  .gal figure{aspect-ratio:1/1}
  .mbar{display:flex;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:50;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--bg) 82%,transparent);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);border-top:1px solid var(--line)}
  .mbar .btn{flex:1;min-height:50px}
  .mbar .btn-s{background:var(--surface);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line)}
  header .w{height:64px}
  .brand{font-size:19px}
}
/* ---- layout: split ---- */
.L-split header,.L-editorial header{position:relative;color:var(--ink);border-bottom:1px solid var(--line)}
.L-split .btn-g,.L-editorial .btn-g{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--line);-webkit-backdrop-filter:none;backdrop-filter:none}
.L-split .proof,.L-editorial .proof{background:var(--surface);box-shadow:0 0 0 1px var(--line);color:var(--ink);-webkit-backdrop-filter:none;backdrop-filter:none}
.proof .dot{width:10px;height:10px;border-radius:50%;background:var(--accent);margin-left:4px}
.hero2{background:var(--surface);border-bottom:1px solid var(--line)}
.h2grid{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(32px,5vw,72px);align-items:center;padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(48px,7vw,96px)}
.hero2 h1{font-size:clamp(40px,5.6vw,72px);margin:18px 0 20px}
.hero2 .lead,.hero3 .lead{font-size:clamp(18px,1.9vw,20px);color:var(--muted);margin:0 0 30px;max-width:46ch}
.h2img{position:relative;border-radius:calc(var(--r) * 1.6);overflow:hidden;aspect-ratio:4/5;box-shadow:0 40px 80px -40px rgba(0,0,0,.45)}
.h2img img{width:100%;height:100%;object-fit:cover}
.h2tag{position:absolute;left:16px;bottom:16px;background:var(--surface);color:var(--ink);font-size:13px;font-weight:600;padding:8px 14px;border-radius:999px}
.L-split .svc{grid-template-columns:1fr;gap:0;border-top:1px solid var(--line)}
.L-split .card{display:grid;grid-template-columns:64px 1fr 1.4fr;align-items:center;gap:24px;background:transparent;box-shadow:none;border-bottom:1px solid var(--line);border-radius:0;padding:26px 4px}
.L-split .card:hover{transform:none;box-shadow:none;background:color-mix(in srgb,var(--accent) 5%,transparent)}
.L-split .card .ic{margin:0;width:48px;height:48px;background:transparent;color:var(--accent);box-shadow:inset 0 0 0 1.5px var(--accent)}
.L-split .card h3{margin:0}
/* ---- layout: editorial ---- */
.hero3{text-align:center;padding-top:clamp(56px,8vw,110px)}
.hero3 .kick::before{display:none}
.hero3 h1{font-size:clamp(46px,7.6vw,108px);max-width:16ch;margin:18px auto 22px;line-height:.98}
.hero3 .lead{margin-left:auto;margin-right:auto}
.hero3 .ctas{justify-content:center}
.hero3 .proof{margin-top:26px}
.h3img{margin-top:clamp(40px,6vw,72px);border-radius:calc(var(--r) * 1.6);overflow:hidden;aspect-ratio:21/9}
.h3img img{width:100%;height:100%;object-fit:cover}
.L-editorial .head{flex-direction:column;align-items:center;text-align:center}
.L-editorial .head p{text-align:center}
.L-editorial .card{text-align:center;background:transparent;box-shadow:inset 0 0 0 1.5px var(--line)}
.L-editorial .card .ic{margin:0 auto 22px;background:transparent;color:var(--accent);box-shadow:inset 0 0 0 1.5px var(--accent);border-radius:50%}
.L-editorial .gal{grid-template-columns:repeat(3,1fr);grid-template-rows:1fr;height:clamp(240px,28vw,380px)}
.L-editorial .gal figure:first-child{grid-row:auto}
.L-editorial .final img{display:none}
.L-editorial .final::before{background:var(--accent)}
@media (max-width:860px){
  .h2grid{grid-template-columns:1fr}.h2img{aspect-ratio:4/3;order:-1}
  .L-split .card{grid-template-columns:48px 1fr;gap:14px}.L-split .card p{grid-column:2}
  .h3img{aspect-ratio:4/3}
  .L-editorial .gal{grid-template-columns:1fr 1fr;height:auto}.L-editorial .gal figure{aspect-ratio:1/1}.L-editorial .gal figure:first-child{grid-column:1/3;aspect-ratio:16/10}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.rv{opacity:1;transform:none;transition:none}.card,.gal img{transition:none}}
</style>
<% if s['final'] -%>
<script type="application/ld+json"><%= local_business_ld(s) %></script>
<% end -%>
</head>
<% lay = s['layout'] || LAYOUT_BY_THEME[s['theme']] || 'bold' -%>
<body class="L-<%= lay %>">
<% if s['final'] || s['no_banner'] -%>
<% elsif s['sample'] -%>
<div class="draft">This is a <b>sample site</b> for a fictional business, made by <a href="<%= HOME %>">Corner Site Co.</a> to show the kind of site we build. Photos via Unsplash.</div>
<% else -%>
<div class="draft"><b>Draft</b> made for <%= e s['name'] %> by <a href="<%= HOME %>">Corner Site Co.</a> · Not their official site · Stock photos <a class="dl" href="#make-it-yours">Make it yours &darr;</a></div>
<% end -%>

<header><div class="w">
  <a class="brand" href="#top"><%= e s['name'] %></a>
  <nav aria-label="Main"><a href="#services">Services</a><a href="#about">About</a><a href="#visit">Visit</a><a class="btn btn-p" href="<%= primary_href %>"><%= icon(s['cta'] == 'email' ? 'mail' : 'phone', 18) %><%= s['cta'] == 'email' ? 'Email us' : e(s['phone']) %></a></nav>
</div></header>

<main id="top">
<% if lay == 'split' -%>
<section class="hero2"><div class="w h2grid">
  <div class="h2txt">
    <span class="kick"><%= e s['kicker'] %></span>
    <h1><%= e s['h1'] %></h1>
    <p class="lead"><%= e s['sub'] %></p>
    <div class="ctas">
      <%= hero_cta %>
      <a class="btn btn-g" href="<%= maps %>" target="_blank" rel="noopener"><%= icon('pin', 20) %>Get directions</a>
    </div>
<% if s['rating'] -%>
    <div class="proof"><span class="stars"><%= stars(s['rating']) %></span><span><b><%= e s['rating'] %></b> from <%= s['reviews'] %> Google reviews</span></div>
<% elsif s['proof'] -%>
    <div class="proof"><span class="dot"></span><span><b><%= e s['proof'] %></b></span></div>
<% end -%>
  </div>
  <div class="h2img"><img src="<%= img(s['photos'][0], 1400) %>" alt="<%= e alt_txt %>" fetchpriority="high"><span class="h2tag"><%= e s['address'].split(',').first %></span></div>
</div></section>
<% elsif lay == 'editorial' -%>
<section class="hero3"><div class="w">
  <span class="kick"><%= e s['kicker'] %></span>
  <h1><%= e s['h1'] %></h1>
  <p class="lead"><%= e s['sub'] %></p>
  <div class="ctas">
    <%= hero_cta %>
    <a class="btn btn-g" href="<%= maps %>" target="_blank" rel="noopener"><%= icon('pin', 20) %>Get directions</a>
  </div>
<% if s['rating'] -%>
  <div class="proof"><span class="stars"><%= stars(s['rating']) %></span><span><b><%= e s['rating'] %></b> from <%= s['reviews'] %> Google reviews</span></div>
<% elsif s['proof'] -%>
  <div class="proof"><span class="dot"></span><span><b><%= e s['proof'] %></b></span></div>
<% end -%>
  <div class="h3img"><img src="<%= img(s['photos'][0], 2000) %>" alt="<%= e alt_txt %>" fetchpriority="high"></div>
</div></section>
<% else -%>
<section class="hero">
  <img class="bgimg" src="<%= img(s['photos'][0], 2000) %>" srcset="<%= img(s['photos'][0], 900) %> 900w, <%= img(s['photos'][0], 1400) %> 1400w, <%= img(s['photos'][0], 2000) %> 2000w" sizes="100vw" alt="<%= e alt_txt %>" fetchpriority="high">
  <div class="w">
    <span class="kick"><%= e s['kicker'] %></span>
    <h1><%= e s['h1'] %></h1>
    <p class="lead"><%= e s['sub'] %></p>
    <div class="ctas">
      <%= hero_cta %>
      <a class="btn btn-g" href="<%= maps %>" target="_blank" rel="noopener"><%= icon('pin', 20) %>Get directions</a>
    </div>
<% if s['rating'] -%>
    <div class="proof"><span class="g"><svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M45 24.5c0-1.6-.1-2.8-.4-4H24v7.6h11.8c-.5 3-3.1 6.9-8.8 9.4l12.4 9.6C44 43 45 34 45 24.5z"/><path fill="#34A853" d="M24 46c6 0 11-2 14.7-5.3l-7-5.4c-1.9 1.3-4.4 2.2-7.7 2.2-5.9 0-10.9-4-12.7-9.4l-7.3 5.6C7.7 41 15.2 46 24 46z"/><path fill="#FBBC05" d="M11.3 28.1c-.5-1.3-.7-2.7-.7-4.1s.3-2.8.7-4.1l-7.3-5.6C2.5 17.3 1.7 20.6 1.7 24s.8 6.7 2.3 9.7z"/><path fill="#EA4335" d="M24 10.5c4.1 0 6.9 1.8 8.5 3.3l6.3-6.1C35 4.2 30 2 24 2 15.2 2 7.7 7 4 14.3l7.3 5.6c1.8-5.4 6.8-9.4 12.7-9.4z"/></svg></span><span class="stars"><%= stars(s['rating']) %></span><span><b><%= e s['rating'] %></b> from <%= s['reviews'] %> Google reviews</span></div>
<% elsif s['proof'] -%>
    <div class="proof"><span class="g" style="background:var(--accent);color:var(--accent-ink)"><%= icon('star', 14) %></span><span><b><%= e s['proof'] %></b></span></div>
<% end -%>
  </div>
</section>
<% end -%>

<section class="info" aria-label="Quick info"><div class="w">
<% if s['tel'] -%>
  <a class="it" href="tel:<%= e s['tel'] %>"><span class="ic"><%= icon('phone') %></span><span><small>Call</small><strong><%= e s['phone'] %></strong></span></a>
<% else -%>
  <a class="it" href="mailto:<%= e s['email'] %>"><span class="ic"><%= icon('mail') %></span><span><small>Email</small><strong><%= e s['email'] %></strong></span></a>
<% end -%>
  <a class="it" href="<%= maps %>" target="_blank" rel="noopener"><span class="ic"><%= icon('pin') %></span><span><small>Find us</small><strong><%= e s['address'] %></strong></span></a>
  <div class="it"><span class="ic"><%= icon('clock') %></span><span><small>Hours</small><strong><%= e s['hours'] %></strong></span></div>
</div></section>

<section id="services" class="sec"><div class="w">
  <div class="head rv"><div><span class="kick">What we do</span><h2 style="margin-top:14px">Services</h2></div><p><%= e s['sub'] %></p></div>
  <div class="svc">
<% s['services'].each do |title, desc, ic| -%>
    <div class="card rv"><div class="ic"><%= icon(ic, 24) %></div><h3><%= e title %></h3><p><%= e desc %></p></div>
<% end -%>
  </div>
<% unless s['sample'] || s['final'] -%>
  <p class="note">Service list to confirm with the owner.</p>
<% end -%>
</div></section>

<section id="about" class="sec" style="padding-top:0"><div class="w split">
  <div class="ph rv"><img src="<%= img(s['photos'][1], 1200) %>" alt="<%= e alt_txt %>" loading="lazy">
<% if s['rating'] -%>
    <div class="badge"><span class="big"><%= e s['rating'] %></span><span><span class="stars"><%= stars(s['rating']) %></span><br><span style="font-size:14px;opacity:.85"><%= s['reviews'] %> Google reviews</span></span></div>
<% end -%>
  </div>
  <div class="rv">
    <span class="kick">About</span>
    <h2><%= e s['about_h'] %></h2>
    <p><%= e s['about'] %></p>
<% if s['rating'] -%>
    <a class="link" href="<%= maps %>" target="_blank" rel="noopener">Read the reviews on Google <%= icon('arrow', 18) %></a>
<% elsif s['instagram'] -%>
    <a class="link" href="https://www.instagram.com/<%= e s['instagram'] %>/" target="_blank" rel="noopener">See what's fresh on Instagram <%= icon('arrow', 18) %></a>
<% else -%>
    <a class="link" href="<%= primary_href %>"><%= e s['cta_label'] %> <%= icon('arrow', 18) %></a>
<% end -%>
  </div>
</div></section>

<section class="sec" style="padding-top:0"><div class="w">
  <div class="gal rv">
    <figure><img src="<%= img(s['photos'][2], 1400) %>" alt="<%= e alt_txt %>" loading="lazy"></figure>
    <figure><img src="<%= img(s['photos'][3], 800) %>" alt="<%= e alt_txt %>" loading="lazy"></figure>
<% if s['sample'] || s['final'] -%>
    <figure><img src="<%= img(s['photos'][0], 800) %>" alt="<%= e alt_txt %>" loading="lazy"></figure>
<% else -%>
    <figure class="yours"><div><b>Your photos here</b><span>Text them to us. Free.</span></div></figure>
<% end -%>
  </div>
  <p class="gal-note"><%= s['final'] ? (s['photo_credit'] || '') : (s['sample'] ? 'Photos via Unsplash.' : 'Placeholder photos via Unsplash. Your own photos go here.') %></p>
</div></section>

<section id="visit" class="sec" style="padding-top:0"><div class="w">
  <div class="head rv"><div><span class="kick">Visit</span><h2 style="margin-top:14px">Come see us.</h2></div></div>
  <div class="visit">
    <div class="vcard rv">
      <div class="row"><span class="ic"><%= icon('pin') %></span><div><small>Address</small><a href="<%= maps %>" target="_blank" rel="noopener"><%= e s['address'] %></a></div></div>
<% if s['tel'] -%>
      <div class="row"><span class="ic"><%= icon('phone') %></span><div><small>Phone</small><a href="tel:<%= e s['tel'] %>"><%= e s['phone'] %></a></div></div>
<% end -%>
<% if s['email'] -%>
      <div class="row"><span class="ic"><%= icon('mail') %></span><div><small>Email</small><a href="mailto:<%= e s['email'] %>"><%= e s['email'] %></a></div></div>
<% end -%>
      <div class="row"><span class="ic"><%= icon('clock') %></span><div><small>Hours</small><span><%= e s['hours'] %></span></div></div>
      <div class="ctas" style="margin-top:auto"><a class="btn btn-p" href="<%= primary_href %>"><%= e s['cta_label'] %></a></div>
    </div>
    <div class="map rv"><iframe src="<%= embed %>" title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
  </div>
</div></section>

<section class="final sec">
  <img src="<%= img(s['photos'][3], 1800) %>" alt="<%= e alt_txt %>" loading="lazy">
  <div class="w rv">
    <h2><%= s['cta'] == 'email' ? 'Questions? Drop us a line.' : 'Ready when you are.' %></h2>
    <p><%= s['cta'] == 'email' ? 'Email us and we will get back to you.' : "Give us a call and we'll take it from there." %></p>
    <div class="ctas"><a class="btn btn-p" href="<%= primary_href %>"><%= icon(s['cta'] == 'email' ? 'mail' : 'phone', 20) %><%= s['cta'] == 'email' ? e(s['email']) : e(s['phone']) %></a></div>
  </div>
</section>
</main>

<% unless s['sample'] || s['final'] -%>
<section class="offer" id="make-it-yours" aria-label="From Corner Site Co.">
  <div class="ow">
    <p class="oe">From Corner Site Co. · not part of the draft</p>
    <h2>Like it? This can be <%= e poss(s['name']) %> real website.</h2>
    <p class="ol">Want your own <%= book ? 'photos, prices and booking link' : 'photos and prices' %> in it first? Text or email me and I'll put them in, free, before you decide anything.</p>
<% if book -%>
    <style>.offer .adds{margin:0 0 28px;padding:18px 20px;border:1px solid rgba(0,0,0,.1);border-radius:14px;background:#fff}.offer .ah{margin:0 0 10px;font:500 11px/1.4 ui-monospace,'SF Mono',Menlo,Consolas,monospace;letter-spacing:.18em;text-transform:uppercase;color:#6e6e73}.offer .adds ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px 22px}.offer .adds li{display:block;padding:0 0 0 22px;border:0;position:relative;font-size:15px;line-height:1.45;counter-increment:none}.offer .adds li::before{content:'✓';position:absolute;left:0;top:0;font:600 14px/1.45 Inter,sans-serif;letter-spacing:0;color:#2f7d4f}@media (max-width:600px){.offer .adds ul{grid-template-columns:1fr}}</style>
    <div class="adds"><p class="ah">What this adds to your booking page</p><ul>
      <li><b>Your own web address</b>, registered in your name.</li>
      <li><b>Your services, hours and story</b> on one page Google can read.</li>
      <li><b>Your work, shown off</b> in a photo gallery.</li>
      <li><b>The same Book button.</b> Bookings still go through the app you use now.</li>
    </ul></div>
<% end -%>
<% if founding -%>
    <div class="f3" style="margin:0 0 24px;padding:18px 20px;border:1px solid rgba(0,0,0,.12);border-radius:14px;background:#fff;font-size:15px;line-height:1.5"><p style="margin:0 0 6px;font:600 12px/1.4 ui-monospace,'SF Mono',Menlo,Consolas,monospace;letter-spacing:.14em;text-transform:uppercase;color:#2f7d4f">Free website for our first 3 Ontario clients · <%= FOUNDING %> of 3 spots left</p><p style="margin:0">We're a new business, and we want our first clients to become our best examples. So the first three Ontario businesses that say yes get their website built and put online <b>free of charge</b>. You'd only pay for your web address (about $20 a year, in your name). Normally $990, or $129/month. All we ask is that we can show your business on our site as an example of our work.</p></div>
<% end -%>
    <ol>
      <li><span><b>Tell us what to change.</b> Your own photos, prices and wording. Two rounds of changes are included.</span></li>
      <li><span><b>Approve the finished site</b> on your phone. It's usually live 3 business days after you approve it.</span></li>
<% if founding -%>
      <li><span><b>Only then, pay:</b> nothing if you're one of our first 3 Ontario clients (just your web address, about $20/year, in your name). After that it's $990 one time, or $129/month with nothing upfront (cancel any time), plus your web address.</span></li>
<% else -%>
      <li><span><b>Only then, pay:</b> $990 one time, or $129/month with nothing upfront (cancel any time). Plus your web address (about $20/year), registered in your name.</span></li>
<% end -%>
    </ol>
    <div class="oc">
      <a class="ob p" href="sms:+16139002378?&amp;body=<%= ERB::Util.url_encode("Hi Michael, it's about the website draft for #{s['name']}.") %>">Text Michael</a>
      <a class="ob" href="mailto:cornersiteco@gmail.com?subject=<%= ERB::Util.url_encode("Website draft for #{s['name']}") %>">Email</a>
      <a class="ob" href="tel:+16139002378">Call · (613) 900-2378</a>
    </div>
    <p class="who"><img src="<%= HOME %>assets/michael-4.jpg" alt="Michael Braden" loading="lazy" width="52" height="52"><span>Michael Braden, Corner Site Co., Ottawa · registered Ontario business no. 1001825094. Not ready? No pressure: the draft stays free to look at. <a href="<%= HOME %>">How it works</a></span></p>
  </div>
</section>
<% end -%>
<% form_to = s['form_action'] || (s['form_email'] || s['email']).to_s; if s['final'] && s['form'] != false && !form_to.empty? -%>
<section class="sec" id="message" aria-label="Send a message"><div class="w" style="max-width:640px">
  <h2>Send us a message</h2>
      <form action="https://formsubmit.co/<%= e form_to %>" method="POST" style="display:grid;gap:14px;margin-top:18px">
      <input type="hidden" name="_subject" value="New message from your website">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
    <label style="display:grid;gap:6px;font-size:15px">Name<input name="name" required autocomplete="name" style="font:inherit;padding:12px 14px;border:1px solid rgba(0,0,0,.2);border-radius:10px"></label>
    <label style="display:grid;gap:6px;font-size:15px">Phone or email<input name="contact" required style="font:inherit;padding:12px 14px;border:1px solid rgba(0,0,0,.2);border-radius:10px"></label>
    <label style="display:grid;gap:6px;font-size:15px">Message<textarea name="message" rows="4" required style="font:inherit;padding:12px 14px;border:1px solid rgba(0,0,0,.2);border-radius:10px"></textarea></label>
    <button class="btn btn-p" type="submit" style="justify-self:start">Send</button>
  </form>
</div></section>
<% end -%>
<footer><div class="w"><span><%= s['final'] ? '&copy; ' : '' %><%= e s['name'] %> · <%= e s['address'] %></span><% if !s['final'] || s['credit'] %><span><%= s['final'] ? 'Website' : (s['sample'] ? 'Sample site' : 'Draft') %> by <a href="<%= HOME %>">Corner Site Co.</a></span><% end %></div></footer>

<div class="mbar"><% if book -%><a class="btn btn-p" href="<%= e book %>" target="_blank" rel="noopener"><%= icon('clock', 18) %><%= e(s['book_label'] ? s['book_label'].split.first : 'Book') %></a><a class="btn btn-s" href="<%= primary_href %>"><%= icon(s['cta'] == 'email' ? 'mail' : 'phone', 18) %><%= s['cta'] == 'email' ? 'Email' : 'Call' %></a><% else -%><a class="btn btn-p" href="<%= primary_href %>"><%= icon(s['cta'] == 'email' ? 'mail' : 'phone', 18) %><%= s['cta'] == 'email' ? 'Email' : 'Call' %></a><a class="btn btn-s" href="<%= maps %>" target="_blank" rel="noopener"><%= icon('pin', 18) %>Directions</a><% end -%></div>

<script>
(function(){var els=document.querySelectorAll('.rv');if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in')});return}
var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{rootMargin:'0px 0px -6% 0px'});els.forEach(function(e){io.observe(e)});})();
</script>
<% unless s['final'] -%>
<script data-goatcounter="https://cornersiteco.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
<% end -%>
</body>
</html>
