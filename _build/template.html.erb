<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% unless s['final'] %><meta name="robots" content="noindex, nofollow"><% end %><% if s['final'] && s['canonical'] %><link rel="canonical" href="<%= e s['canonical'] %>"><% end %>
<title><%= e s['name'] %><%= s['final'] ? ' — ' + e([c.trade, c.city].reject { |x| blank?(x) }.join(', ')) : (s['sample'] ? ' — sample site by Corner Site Co.' : ' — draft concept by Corner Site Co.') %></title>
<meta name="description" content="<%= e s['sub'] %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= e s['name'] %><%= (s['sample'] || s['final']) ? '' : ' — website draft' %>">
<meta property="og:description" content="<%= e s['sub'] %>">
<% unless c.photos.empty? -%>
<meta property="og:image" content="<%= img(c.photos[0], 1200) %>">
<% end -%>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="<%= t['bg'] %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://images.unsplash.com">
<% c.font_urls.each do |u| -%>
<link rel="stylesheet" href="<%= u %>" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="<%= u %>"></noscript>
<% end -%>
<style>
:root{<%= c.css_vars %>}
<%= page_css %>
<%= c.brand_css %></style>
<% if s['final'] -%>
<script type="application/ld+json"><%= local_business_ld(s) %></script>
<% end -%>
</head>
<body class="A-<%= c.art %> P-<%= c.pal_name %> V<%= c.v %> <%= c.flags %><%= t['dark'] ? ' is-dark' : '' %>"<% if c.week %> data-week="<%= e c.week_json %>" data-tz="<%= c.tz %>"<% end %>>
<% if s['final'] || s['no_banner'] -%>
<% elsif s['sample'] -%>
<div class="ban"><p><span class="tag">Sample</span> A <b>sample site</b> for a fictional business, made by <a href="<%= HOME %>">Corner Site Co.</a> to show the kind of site we build.<%= c.np > 0 ? ' Photos via Unsplash.' : '' %></p></div>
<% else -%>
<div class="ban"><p class="bd"><span class="b1"><span class="tag">Draft</span> Made for <%= e s['name'] %> by <a href="<%= HOME %>">Corner Site Co.</a></span><span class="bs"> · </span><span class="b2"><span>Not their official site<%= c.np > 0 ? ' · Stock photos' : '' %></span> <a class="dl" href="#make-it-yours">Make it yours &darr;</a></span></p></div>
<% end -%>
<%= body_html %>
<% unless c.colophon.empty? -%>
<p class="colo"><span><%= e c.colophon %></span></p>
<% end -%>
<% if c.draft? -%>
<section class="offer" id="make-it-yours" aria-label="From Corner Site Co.">
  <div class="ow">
    <p class="oe">From Corner Site Co. · not part of the draft</p>
    <h2>Like it? This can be <%= tx poss(s['name']) %> real website.</h2>
    <p class="ol">Want your own <%= book ? 'photos, prices and booking link' : 'photos and prices' %> in it first? Text or email me and I&rsquo;ll put them in, free, before you decide anything.</p>
<% if book -%>
    <div class="ocard adds"><p class="ah">What this adds to your booking page</p><ul>
      <li><b>Your own web address</b>, registered in your name.</li>
      <li><b>Your services, hours and story</b> on one page Google can read.</li>
      <li><b>Your work, shown off</b> in a photo gallery.</li>
      <li><b>The same Book button.</b> Bookings still go through the app you use now.</li>
    </ul></div>
<% end -%>
<% if founding -%>
    <div class="ocard f3"><p class="ah">Free website for our first 3 clients <b><%= FOUNDING %> of 3 spots left</b></p><p>We&rsquo;re a new business, and we want our first clients to become our best examples. So the first three businesses that say yes get their website finished and put online <b>free of charge</b>. You&rsquo;d only pay for your web address (about $20 a year, in your name). Normally $20/month, or $490 once. All we ask is that we can show your business on our site as an example of our work.</p></div>
<% end -%>
    <ol>
      <li><span><b>Tell us what to change.</b> Your own photos, prices and wording. Two rounds of changes are included.</span></li>
      <li><span><b>Approve the finished site</b> on your phone. It&rsquo;s usually live 3 business days after you approve it.</span></li>
<% if founding -%>
      <li><span><b>Only then, pay:</b> nothing if you&rsquo;re one of our first 3 clients (just your web address, about $20/year, in your name). After that it&rsquo;s $20/month with nothing upfront (cancel any time), or $490 one time, plus your web address.</span></li>
<% else -%>
      <li><span><b>Only then, pay:</b> $20/month with nothing upfront (cancel any time), or $490 one time. Plus your web address (about $20/year), registered in your name.</span></li>
<% end -%>
    </ol>
    <div class="oc">
      <a class="ob p" href="sms:+16139002378?&amp;body=<%= ERB::Util.url_encode("Hi Michael, it's about the website draft for #{s['name']}.") %>">Text Michael</a>
      <a class="ob" href="mailto:cornersiteco@gmail.com?subject=<%= ERB::Util.url_encode("Website draft for #{s['name']}") %>">Email</a>
      <a class="ob" href="tel:+16139002378">Call · (613) 900-2378</a>
    </div>
    <p class="who"><img src="<%= HOME %>assets/michael-4.jpg" alt="Michael Braden" loading="lazy" width="52" height="52"><span>Michael Braden, Corner Site Co., Ottawa · registered Ontario business no. 1001825094. Not ready? No pressure: the draft stays free to look at. <a href="<%= HOME %>">How it works</a></span></p>
  </div>
</section>
<% end -%>
<% form_to = s['form_action'] || (s['form_email'] || s['email']).to_s; if s['final'] && s['form'] != false && !form_to.empty? -%>
<section class="msg" id="message" aria-label="Send a message"><div class="msg-w">
  <h2>Send us a message</h2>
      <form action="https://formsubmit.co/<%= e form_to %>" method="POST" style="display:grid;gap:14px;margin-top:18px">
      <input type="hidden" name="_subject" value="New message from your website">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
    <label style="display:grid;gap:6px;font-size:15px">Name<input name="name" required autocomplete="name" style="font:inherit;padding:12px 14px;border:1px solid var(--line);border-radius:var(--r);background:var(--paper);color:var(--ink)"></label>
    <label style="display:grid;gap:6px;font-size:15px">Phone or email<input name="contact" required style="font:inherit;padding:12px 14px;border:1px solid var(--line);border-radius:var(--r);background:var(--paper);color:var(--ink)"></label>
    <label style="display:grid;gap:6px;font-size:15px">Message<textarea name="message" rows="4" required style="font:inherit;padding:12px 14px;border:1px solid var(--line);border-radius:var(--r);background:var(--paper);color:var(--ink)"></textarea></label>
    <button class="act act-p" type="submit" style="justify-self:start"><span>Send</span></button>
  </form>
</div></section>
<% end -%>
<footer class="foot"><div class="foot-w"><span><%= s['final'] ? '&copy; ' : '' %><%= e s['name'] %><%= c.addr? ? ' · ' + e(s['address']) : '' %></span><% if !s['final'] || s['credit'] %><span><%= s['final'] ? 'Website' : (s['sample'] ? 'Sample site' : 'Draft') %> by <a href="<%= HOME %>">Corner Site Co.</a></span><% end %></div></footer>

<% acts = c.actions.first(2) -%>
<% unless acts.empty? -%>
<div class="mbar"><% acts.each_with_index do |x, i| -%><a class="<%= i == 0 ? 'mp' : 'mq' %>" href="<%= e x[:href] %>"<%= x[:ext] ? ' target="_blank" rel="noopener"' : '' %>><%= icon((x[:k] == 'book' && s['book_label'].to_s =~ /order/i) ? 'bag' : x[:k], 18) %><%= e(x[:k] == 'book' ? (s['book_label'] ? s['book_label'].split.first : 'Book') : (x[:k] == 'phone' ? 'Call' : (x[:k] == 'mail' ? 'Email' : 'Directions'))) %></a><% end -%></div>
<% end -%>

<script>
(function(){var b=document.body,D=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
function f(t){t%=1440;var h=Math.floor(t/60),m=t%60,a=h<12?'am':'pm';h=h%12||12;return h+(m?':'+(m<10?'0':'')+m:'')+' '+a}
try{var w=b.dataset.week&&JSON.parse(b.dataset.week);if(w){var p={};new Intl.DateTimeFormat('en-CA',{timeZone:b.dataset.tz,weekday:'short',hour:'numeric',minute:'numeric',hourCycle:'h23'}).formatToParts(new Date()).forEach(function(x){p[x.type]=x.value});
var d=D.indexOf(p.weekday.slice(0,3)),m=(+p.hour%24)*60+ +p.minute,t=w[d],y=w[(d+6)%7],s='',o=false,i,n;
if(y&&y[1]>1440&&m<y[1]-1440){o=true;s='Open now · closes '+f(y[1])}
else if(t&&m>=t[0]&&m<t[1]){o=true;s='Open now · closes '+f(t[1])}
else if(t&&m<t[0]){s='Closed now · opens '+f(t[0])}
else if(t!==null){s='Closed now';for(i=1;i<8;i++){n=w[(d+i)%7];if(n===null)break;if(n){s+=' · opens '+(i==1?'tomorrow':D[(d+i)%7])+' '+f(n[0]);break}}}
if(s)document.querySelectorAll('[data-now]').forEach(function(el){el.textContent=s;el.classList.add(o?'is-open':'is-shut');el.hidden=false});
document.querySelectorAll('tr[data-d="'+d+'"]').forEach(function(r){r.classList.add('today')})}}catch(e){}
document.querySelectorAll('.copy').forEach(function(c){c.addEventListener('click',function(){var v=c.dataset.copy,l=c.textContent;function ok(){c.textContent='Copied';setTimeout(function(){c.textContent=l},1800)}
if(navigator.clipboard)navigator.clipboard.writeText(v).then(ok,function(){});})});
/* the phone bar steps aside while the page's own buttons are on screen, so the same action is never shown twice */
var mb=document.querySelector('.mbar'),ha=document.querySelector('main .acts');
if(mb&&ha&&'IntersectionObserver' in window){new IntersectionObserver(function(en){mb.classList.toggle('is-away',en[0].isIntersecting)},{threshold:.6}).observe(ha)}
/* brand fonts: measure the name in the real font and make it fit (poster lines fill the width; other names only ever shrink) */
if(b.classList.contains('bfit')&&document.fonts){var cv=document.createElement('canvas').getContext('2d');
function em(el,x){var cs=getComputedStyle(el),tt=cs.textTransform,fs=parseFloat(cs.fontSize)||1;x=tt=='uppercase'?x.toUpperCase():tt=='lowercase'?x.toLowerCase():x;cv.font=cs.fontStyle+' '+cs.fontWeight+' 100px '+cs.fontFamily;return cv.measureText(x).width/100+(parseFloat(cs.letterSpacing)||0)/fs*x.length}
function fit(){document.querySelectorAll('.pl').forEach(function(el){var v=em(el,el.textContent);if(v>0)el.style.setProperty('--w',v.toFixed(3))});
document.querySelectorAll('.name,.plate').forEach(function(el){el.style.fontSize='';var cs=getComputedStyle(el),fs=parseFloat(cs.fontSize),W=el.clientWidth-parseFloat(cs.paddingLeft)-parseFloat(cs.paddingRight),m=0;if(!W)return;
el.textContent.trim().split(/\s+/).forEach(function(x){m=Math.max(m,em(el,x))});if(m*fs>W)el.style.fontSize=Math.floor(W/m*.985)+'px'})}
document.fonts.ready.then(fit);var ft;addEventListener('resize',function(){clearTimeout(ft);ft=setTimeout(fit,120)})}
/* quiet arrival: what is below the first screen eases in as it arrives. Nothing is ever hidden waiting for this script. */
if('IntersectionObserver' in window&&!matchMedia('(prefers-reduced-motion:reduce)').matches){var vh=innerHeight,io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{rootMargin:'0px 0px 6% 0px'});
document.querySelectorAll('main section>.w>*,main>.wall,main>.strip,main>.cover,.offer .ow').forEach(function(el){if(el.getBoundingClientRect().top>vh*1.1)io.observe(el)})}})();
</script>
<% unless s['final'] -%>
<script data-goatcounter="https://cornersiteco.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
<% end -%>
</body>
</html>
